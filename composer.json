{
    "name": "degecko/laravel-blade-inline",
    "version": "1.2.1",
    "description": "Inline Blade partials at compile time for faster rendering in loops",
    "keywords": ["laravel", "blade", "inline", "partial", "performance"],
    "license": "MIT",
    "authors": [
        {
            "name": "Cosmin Gheorghita",
            "email": "gecko.alpad@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "DeGecko\\BladeInline\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeGecko\\BladeInline\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "DeGecko\\BladeInline\\BladeInlineServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "orchestra/testbench": "^11.1",
        "phpunit/phpunit": "^13.1"
    }
}
